{
    admin off
    auto_https off
}

:{$PORT} {
    root * /app/public
    encode gzip zstd

    # Route PHP requests ke PHP-FPM (default Nixpacks di port 9000)
    php_fastcgi 127.0.0.1:9000

    # Teruskan request Laravel ke front controller index.php
    try_files {path} {path}/ /index.php?{query}

    file_server
}
